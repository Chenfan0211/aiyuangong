DOMAIN=ops.example.com
ACME_EMAIL=admin@example.com
POSTGRES_DB=mall_ops
POSTGRES_USER=mall_ops
POSTGRES_PASSWORD=replace-with-long-random-password
STORE_AGENT_LOG_LEVEL=INFO
STORE_AGENT_STORE_ID=WH-LION-001
STORE_AGENT_TENANT_ID=LPL-001
STORE_AGENT_BASE_URL=https://ops.example.com

# 以下 /app 路径供 Compose 内 app/ops 服务使用；本地无容器运行请改用项目相对路径。
STORE_AGENT_CONFIG=/app/store_config.json
STORE_AGENT_EVIDENCE_DIR=/app/evidence
STORE_AGENT_IMPORT_INBOX=/app/imports/inbox
STORE_AGENT_OUTBOX_DIR=/app/data/outbox
STORE_AGENT_OPS_LOCK=/app/data/ops/daily_sync.lock
STORE_AGENT_LLM_API_KEY=
STORE_AGENT_LLM_BASE_URL=
STORE_AGENT_LLM_MODEL=
STORE_AGENT_ALERT_CHANNEL=outbox
FEISHU_WEBHOOK_URL=
WECOM_WEBHOOK_URL=
STORE_AGENT_MFA_ENFORCE=1
STORE_AGENT_MFA_KEY=replace-with-long-random-mfa-encryption-key
STORE_AGENT_INBOUND_SIGNING_SECRET=replace-with-long-random-inbound-signing-secret

# 审批回调：默认 mock 无需密钥；切换 feishu/wecom 时必须补齐对应变量。
STORE_AGENT_APPROVAL_CALLBACK_PROVIDER=mock
STORE_AGENT_APPROVAL_CALLBACK_SECRET=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=

# 备份：无第三方密钥时保持 local；切换 S3 后填写下方对象存储变量。
STORE_AGENT_BACKUP_STORAGE=local
STORE_AGENT_BACKUP_LOCAL_ROOT=/app/data/backups
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY_FILE=/app/data/backups/.backup-key
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_PREFIX=aiyuangong/wh-lion-001
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PATH_STYLE=true
