# 门店运营 Agent 环境变量样例
# 用法：复制为 config/.env 并填入真实值，或直接在系统中设置同名环境变量。
# 切勿提交真实密钥；大模型为可选项，不配置时 Agent 走规则模式（一期默认）。

# 密钥（二选一，优先 STORE_AGENT_LLM_API_KEY）
STORE_AGENT_LLM_API_KEY=
DEEPSEEK_API_KEY=

# 接口地址（默认 https://api.deepseek.com/v1）
STORE_AGENT_LLM_BASE_URL=
DEEPSEEK_BASE_URL=

# 模型名（默认 deepseek-chat）
STORE_AGENT_LLM_MODEL=
DEEPSEEK_MODEL=

# 入站消息签名密钥；未配置时 /api/inbound/messages 返回 503，网页对话不受影响。
STORE_AGENT_INBOUND_SIGNING_SECRET=
